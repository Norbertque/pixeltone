    <string name="usb_rates">Rates: %1$s</string>
    <string name="usb_volume">Volume</string>
    <string name="usb_dac_volume">DAC volume</string>
    <string name="usb_software_volume">Software volume</string>
    <string name="usb_software_volume_text">The DAC has no volume of its own, so Pixeltone turns it down; at 0 dB the output is bit-perfect again.</string>
    <string name="usb_loud_title">Louder than −10 dB?</string>
    <string name="usb_loud_text">Some DACs drive earphones very loud at full scale. Check the level before you go higher.</string>
    <string name="usb_loud_allow">Allow louder</string>
    <string name="usb_fixed">Line level</string>
    <string name="usb_fixed_text">Full scale, no volume here: for an amplifier after the DAC.</string>
    <string name="usb_licence">USB output uses libusb (LGPL 2.1); its source is in Pixeltone’s repository.</string>

